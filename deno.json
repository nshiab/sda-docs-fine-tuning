{
  "tasks": {
    "all": "deno task generate && deno task trainAndTest && deno task charts",
    "generate": "deno run --node-modules-dir=auto -A --check sda/generate.ts",
    "charts": "deno run --node-modules-dir=auto -A --check sda/charts.ts",
    "trainAndTest": "deno run --node-modules-dir=auto -A --check sda/trainAndTest.ts",
    "clean": "rm -rf .sda-cache && rm -rf .journalism-cache && rm -rf .tmp"
  },
  "nodeModulesDir": "auto",
  "imports": {
    "@nshiab/journalism": "jsr:@nshiab/journalism@^1.34.12",
    "@nshiab/simple-data-analysis": "jsr:@nshiab/simple-data-analysis@^5.6.34",
    "@observablehq/plot": "npm:@observablehq/plot@^0.6.17"
  }
}
